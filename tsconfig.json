{
  "compilerOptions": {
    "target": "ES2024",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "rootDir": "src",
    "module": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noEmitOnError": true,
    "outDir": "dist",
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
